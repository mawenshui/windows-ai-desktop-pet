{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windows-ai-desktop-pet.local/schemas/pet.schema.json",
  "title": "Windows AI Desktop Pet package",
  "type": "object",
  "required": ["id", "displayName", "version", "source", "frameInventory", "render"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "required": ["license", "attributionRequired"],
      "properties": {
        "license": {
          "type": "string",
          "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "MIT", "Apache-2.0"]
        },
        "attributionRequired": { "type": "boolean" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "frameInventory": {
      "type": "object",
      "required": ["characters", "preferred", "filePathPattern", "framesPerAction"],
      "properties": {
        "characters": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "preferred": { "type": "string" },
        "filePathPattern": { "type": "string", "minLength": 1 },
        "deathFilePathPattern": { "type": "string" },
        "framesPerAction": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["fps"],
      "properties": { "fps": { "type": "integer", "minimum": 1, "maximum": 60 } }
    }
  },
  "additionalProperties": true
}
