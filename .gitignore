# Operating system and editors
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
*.tmp
*.bak

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
secrets/

# Logs and reports
*.log
logs/
coverage/
test-results/

# Language/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.cache/
**/bin/
**/obj/

# Temporary build output; final release artifacts under dist/ are tracked.
build/*
!build/.gitkeep

# Local release downloads and temporary staging
release-staging/
*.download

# Superseded local 0.1.0 verification artefacts (never released).
dist/_old_*.png
dist/RUNTIME-VERIFICATION-v0.1.0.md
dist/e2e-summary.json
dist/installer/windows-ai-desktop-pet-v0.1.0-installer-staging.zip
dist/portable/windows-ai-desktop-pet-v0.1.0-portable.zip
dist/portable/windows-ai-desktop-pet-v0.1.0-portable/

# Expanded portable folders and pre-0.7 local archives are retained only as
# local verification history. Release deliverables remain the versioned ZIP,
# installer, and checksum files explicitly added for the current release.
dist/portable/*-portable/
dist/portable/windows-ai-desktop-pet-v0.2.0-portable.zip
dist/portable/windows-ai-desktop-pet-v0.2.1-portable.zip
dist/portable/windows-ai-desktop-pet-v0.2.2-portable.zip
dist/portable/windows-ai-desktop-pet-v0.2.3-portable.zip
dist/portable/windows-ai-desktop-pet-v0.3.0-portable.zip
dist/portable/windows-ai-desktop-pet-v0.4.0-portable.zip
dist/portable/windows-ai-desktop-pet-v0.5.0-portable.zip
dist/portable/windows-ai-desktop-pet-v0.6.0-portable.zip

# Local-only reference materials are never repository deliverables.
# Redistributable assets must be curated into assets/ with license records.
res/
