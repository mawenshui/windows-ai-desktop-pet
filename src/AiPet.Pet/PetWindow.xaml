<Window x:Class="AiPet.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiPet"
        Width="176"
        Height="198"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="True"
        AutomationProperties.Name="桌面宠物"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Grid x:Name="RootGrid" Width="176" Height="198">
        <Border x:Name="StatusBubble"
                MaxWidth="164"
                Padding="12,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#FFFFFCF8"
                BorderBrush="#88E6DBCF"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.15" Color="#6659483C" />
            </Border.Effect>
            <TextBlock x:Name="StatusText"
                       Text="点我打开工具"
                       Foreground="#FF33302E"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       TextAlignment="Center" />
        </Border>

        <Image x:Name="PetImage"
               Width="148"
               Height="148"
               Margin="0,42,0,0"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality"
               ToolTip="单击打开工具，拖动移动位置"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform x:Name="MirrorTransform" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
