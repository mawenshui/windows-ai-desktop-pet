<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.12.1</Version>
    <AssemblyVersion>0.12.1.0</AssemblyVersion>
    <FileVersion>0.12.1.0</FileVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AiPet.App</RootNamespace>
    <AssemblyName>WindowsAiDesktopPet</AssemblyName>
    <AssemblyTitle>Windows AI Desktop Pet</AssemblyTitle>
    <Product>Windows AI Desktop Pet</Product>
    <Company>Windows AI Desktop Pet Contributors</Company>
    <Authors>Windows AI Desktop Pet Contributors</Authors>
    <Description>一款兼顾陪伴、搜索、快捷启动、待办与提醒的 Windows 桌面助手。</Description>
    <Copyright>Copyright © 2026 Windows AI Desktop Pet Contributors</Copyright>
    <ApplicationIcon>..\..\assets\icons\windows-ai-desktop-pet.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>AiPet.App.Program</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiPet.Common\AiPet.Common.csproj" />
    <ProjectReference Include="..\AiPet.Storage\AiPet.Storage.csproj" />
    <ProjectReference Include="..\AiPet.Pet\AiPet.Pet.csproj" />
    <ProjectReference Include="..\AiPet.ToolWindow\AiPet.ToolWindow.csproj" />
    <ProjectReference Include="..\AiPet.Search\AiPet.Search.csproj" />
    <ProjectReference Include="..\AiPet.Shortcuts\AiPet.Shortcuts.csproj" />
    <ProjectReference Include="..\AiPet.AI\AiPet.AI.csproj" />
    <ProjectReference Include="..\AiPet.Secrets\AiPet.Secrets.csproj" />
    <ProjectReference Include="..\AiPet.SystemIntegration\AiPet.SystemIntegration.csproj" />
    <ProjectReference Include="..\AiPet.Todos\AiPet.Todos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\icons\windows-ai-desktop-pet.ico" Link="assets\icons\windows-ai-desktop-pet.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Disable WPF's auto-generated Main from App.xaml: we own Main in Program.cs. -->
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>

</Project>
