<Window x:Class="AiPet.ToolWindow.AiConfigurationPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="完整 AI 配置包"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FAF7F2"
        Foreground="#302C29"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#D8CEC3" />
            <Setter Property="Background" Value="#FFFDFC" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#D8CEC3" />
            <Setter Property="Background" Value="#FFFDFC" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>
    <Border Padding="24" BorderBrush="#E6DDD4" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="保护完整 AI 配置" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="PurposeTextBlock" Margin="0,8,0,0" Foreground="#716861" TextWrapping="Wrap" />
            <Border Margin="0,14,0,0" Padding="12" Background="#FFF4DF" BorderBrush="#E8C98B" BorderThickness="1" CornerRadius="8">
                <TextBlock Text="配置包含 API Key。请使用独立迁移口令，并通过可信渠道传递文件。口令不会保存，遗失后无法恢复。" Foreground="#6C4B16" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="迁移口令" Margin="0,16,0,6" FontWeight="SemiBold" />
            <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" automation:AutomationProperties.Name="完整 AI 配置包迁移口令" />
            <StackPanel x:Name="ConfirmationPanel">
                <TextBlock Text="再次输入" Margin="0,12,0,6" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordConfirmationInput" PasswordChanged="PasswordInput_PasswordChanged" automation:AutomationProperties.Name="再次输入迁移口令" />
            </StackPanel>
            <TextBlock x:Name="ErrorTextBlock" Margin="0,8,0,0" Foreground="#A1392F" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" IsCancel="True" />
                <Button x:Name="ConfirmButton" Content="继续" IsDefault="True" Click="ConfirmButton_Click" Background="#B75D35" Foreground="White" BorderBrush="#9C4D2D" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
