<UserControl x:Class="AiPet.ToolWindow.NotificationInbox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
    <Expander Header="{Binding NotificationSummary}" IsExpanded="True">
        <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource Ink}">
            <ListBox ItemsSource="{Binding NotificationHistory}" MaxHeight="195" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="提醒队列与历史">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel><TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,8,0"/><TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></WrapPanel>
                    <WrapPanel Visibility="{Binding CanHandle, Converter={StaticResource VisibleWhenTrue}}" Margin="0,6,0,0">
                        <Button Content="完成" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.CompleteNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Padding="8,4" MinHeight="32"/>
                        <Button Content="稍后" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.SnoozeNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Padding="8,4" MinHeight="32" Margin="6,0"/>
                        <Button Content="详情" Style="{DynamicResource SecondaryButton}" Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Padding="8,4" MinHeight="32"/>
                    </WrapPanel>
                </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="稍后时长（分钟）" Style="{DynamicResource SectionLabel}"/>
            <ListBox ItemsSource="{Binding SnoozeOptions}" SelectedItem="{Binding SnoozeMinutes}" Style="{DynamicResource InlineChoiceList}" ItemContainerStyle="{DynamicResource SegmentInlineChoiceItem}" AutomationProperties.Name="稍后提醒时长"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
            <Expander Header="静默与历史" Margin="0,8,0,0"><StackPanel>
                <CheckBox Content="启用静默时段（当前 Windows 时区）" IsChecked="{Binding QuietEnabled}"/>
                <WrapPanel><TextBox Width="90" Text="{Binding QuietStart}" Style="{DynamicResource Field}" AutomationProperties.Name="静默开始时间"/><TextBlock Text=" 至 " VerticalAlignment="Center"/><TextBox Width="90" Text="{Binding QuietEnd}" Style="{DynamicResource Field}" AutomationProperties.Name="静默结束时间"/><Button Content="保存" Style="{DynamicResource SecondaryButton}" Command="{Binding SaveQuietHoursCommand}" Margin="6,0"/></WrapPanel>
                <WrapPanel Margin="0,8,0,0"><Button Content="测试提醒通道" Style="{DynamicResource SecondaryButton}" Command="{Binding TestNotificationCommand}" Margin="0,0,6,6"/><Button Content="清除已处理历史" Style="{DynamicResource SecondaryButton}" Command="{Binding ClearNotificationHistoryCommand}" Margin="0,0,0,6"/></WrapPanel>
                <TextBlock Text="已提交表示宿主接受了请求，不能确认你已看到。退出应用期间不会准点提醒。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11"/>
            </StackPanel></Expander>
        </StackPanel>
    </Expander>
</UserControl>
