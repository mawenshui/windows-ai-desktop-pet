<UserControl x:Class="AiPet.ToolWindow.NotificationInbox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="NotificationInbox_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>
    <Expander Header="{Binding NotificationSummary}" IsExpanded="True"
              AutomationProperties.Name="{Binding NotificationSummary}">
        <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource Ink}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NotificationQueryBox" Grid.Column="0" Height="40"
                         Style="{DynamicResource Field}"
                         Text="{Binding NotificationQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="NotificationQueryBox"
                         AutomationProperties.Name="查找提醒标题"
                         AutomationProperties.HelpText="只在本机当前提醒记录中查找标题；提醒区域内按 Ctrl+F 可聚焦" />
                <Button Grid.Column="2" Content="清空" MinHeight="36" Padding="11,5"
                        Style="{DynamicResource SecondaryButton}"
                        Command="{Binding ClearNotificationQueryCommand}"
                        Click="ClearNotificationQuery_Click"
                        Visibility="{Binding HasNotificationQuery, Converter={StaticResource VisibleWhenTrue}}"
                        AutomationProperties.Name="清空提醒查找" />
            </Grid>

            <TextBlock Text="提醒分段" Style="{DynamicResource SectionLabel}" Margin="0,9,0,5" />
            <Border Style="{DynamicResource InlineSegmentGroup}">
                <ListBox x:Name="NotificationFilterSelector"
                         ItemsSource="{Binding NotificationFilters}"
                         DisplayMemberPath="DisplayText"
                         SelectedItem="{Binding SelectedNotificationFilter, Mode=TwoWay}"
                         Style="{DynamicResource InlineChoiceList}"
                         ItemContainerStyle="{DynamicResource SegmentInlineChoiceItem}"
                         AutomationProperties.AutomationId="NotificationFilterSelector"
                         AutomationProperties.Name="提醒记录分段">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <TextBlock Text="记录排序" Style="{DynamicResource SectionLabel}" Margin="0,9,0,5" />
            <Border Style="{DynamicResource InlineSegmentGroup}">
                <ListBox x:Name="NotificationSortSelector"
                         ItemsSource="{Binding NotificationSortOptions}"
                         DisplayMemberPath="DisplayName"
                         SelectedItem="{Binding SelectedNotificationSort, Mode=TwoWay}"
                         Style="{DynamicResource InlineChoiceList}"
                         ItemContainerStyle="{DynamicResource SegmentInlineChoiceItem}"
                         AutomationProperties.AutomationId="NotificationSortSelector"
                         AutomationProperties.Name="提醒记录排序">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <TextBlock Text="{Binding NotificationFilterSummary}" Margin="1,7,0,5"
                       Foreground="{DynamicResource Muted}" FontSize="11"
                       AutomationProperties.LiveSetting="Polite" />

            <Border Style="{DynamicResource EmptyState}" Margin="0,2,0,0"
                    Visibility="{Binding HasNoVisibleNotifications, Converter={StaticResource VisibleWhenTrue}}">
                <StackPanel>
                    <TextBlock Text="{Binding NotificationEmptyMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" />
                    <Button Content="{Binding NotificationEmptyActionLabel}" MinHeight="36" Padding="11,5"
                            HorizontalAlignment="Left" Margin="0,8,0,0"
                            Style="{DynamicResource SecondaryButton}"
                            Command="{Binding NotificationEmptyStateCommand}"
                            AutomationProperties.Name="{Binding NotificationEmptyActionLabel}" />
                </StackPanel>
            </Border>

            <ListBox x:Name="NotificationItemsList" ItemsSource="{Binding NotificationHistory}"
                     SelectedItem="{Binding SelectedNotification, Mode=TwoWay}"
                     MaxHeight="220" Margin="0,2,0,0"
                     Style="{DynamicResource InlineChoiceList}"
                     ItemContainerStyle="{DynamicResource InlineChoiceRowItem}"
                     Visibility="{Binding HasVisibleNotifications, Converter={StaticResource VisibleWhenTrue}}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     MouseDoubleClick="NotificationItems_MouseDoubleClick"
                     AutomationProperties.AutomationId="NotificationItemsList"
                     AutomationProperties.Name="提醒队列与历史"
                     AutomationProperties.HelpText="方向键、Home 或 End 选择；Enter 或 F2 打开详情，Ctrl+Enter 完成，Ctrl+Shift+Enter 稍后">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel AutomationProperties.Name="{Binding AutomationName}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource Ink}" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding TimeText, StringFormat=计划 {0}}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource Muted}" FontSize="11" />
                            </WrapPanel>
                            <TextBlock Text="{Binding RecoveryText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"
                                       Visibility="{Binding IsRecovery, Converter={StaticResource VisibleWhenTrue}}"
                                       AutomationProperties.Name="提醒来源：启动后恢复" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="NotificationSelectedActionBar"
                    Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource AccentSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,8,0,0"
                    Visibility="{Binding HasSelectedNotification, Converter={StaticResource VisibleWhenTrue}}"
                    AutomationProperties.Name="所选提醒操作">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedNotificationSummary}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Margin="0,7,0,0">
                        <Button Content="详情" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                Style="{DynamicResource SecondaryButton}"
                                Command="{Binding OpenSelectedNotificationCommand}"
                                Visibility="{Binding CanOpenSelectedNotification, Converter={StaticResource VisibleWhenTrue}}"
                                AutomationProperties.Name="{Binding SelectedNotificationOpenAutomationName}" />
                        <Button Content="完成" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                Style="{DynamicResource PrimaryButton}"
                                Command="{Binding CompleteSelectedNotificationCommand}"
                                Visibility="{Binding CanActOnSelectedNotification, Converter={StaticResource VisibleWhenTrue}}"
                                AutomationProperties.Name="{Binding SelectedNotificationCompleteAutomationName}" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding CanActOnSelectedNotification, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Text="稍后时长（分钟）" Style="{DynamicResource SectionLabel}" Margin="0,3,0,5" />
                        <ListBox ItemsSource="{Binding SnoozeOptions}" SelectedItem="{Binding SnoozeMinutes, Mode=TwoWay}"
                                 Style="{DynamicResource InlineChoiceList}"
                                 ItemContainerStyle="{DynamicResource SegmentInlineChoiceItem}"
                                 AutomationProperties.Name="所选提醒的稍后时长">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                        <Button Content="按所选时长稍后" MinHeight="36" Padding="11,5" Margin="0,7,0,0"
                                HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}"
                                Command="{Binding SnoozeSelectedNotificationCommand}"
                                AutomationProperties.Name="{Binding SelectedNotificationSnoozeAutomationName}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Expander Header="静默与历史" Margin="0,10,0,0">
                <StackPanel>
                    <CheckBox Content="启用静默时段（当前 Windows 时区）"
                              IsChecked="{Binding QuietEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="启用提醒静默时段" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开始（HH:mm）" Style="{DynamicResource SectionLabel}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding QuietStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="5" Style="{DynamicResource Field}"
                                     AutomationProperties.Name="静默开始时间，24 小时 HH:mm" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="结束（HH:mm）" Style="{DynamicResource SectionLabel}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding QuietEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="5" Style="{DynamicResource Field}"
                                     AutomationProperties.Name="静默结束时间，24 小时 HH:mm" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,7,0,0">
                        <Button Content="夜间 22–08" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                Style="{DynamicResource SecondaryButton}" Command="{Binding ApplyQuietPresetCommand}" CommandParameter="night"
                                AutomationProperties.Name="应用夜间二十二点到八点静默草稿" />
                        <Button Content="午休 12–13" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                Style="{DynamicResource SecondaryButton}" Command="{Binding ApplyQuietPresetCommand}" CommandParameter="lunch"
                                AutomationProperties.Name="应用午休十二点到十三点静默草稿" />
                        <Button Content="关闭静默" MinHeight="36" Padding="11,5" Margin="0,0,0,5"
                                Style="{DynamicResource SecondaryButton}" Command="{Binding ApplyQuietPresetCommand}" CommandParameter="off"
                                AutomationProperties.Name="在草稿中关闭提醒静默" />
                    </WrapPanel>
                    <TextBlock Text="{Binding QuietValidationHint}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource Muted}" Margin="0,2,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Content="{Binding QuietSettingsSaveLabel}" MinHeight="36" Padding="11,5" Margin="0,7,0,0"
                            HorizontalAlignment="Left" Style="{DynamicResource SecondaryButton}"
                            Command="{Binding SaveQuietHoursCommand}"
                            AutomationProperties.Name="保存提醒静默设置" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="测试提醒通道" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                Style="{DynamicResource SecondaryButton}" Command="{Binding TestNotificationCommand}"
                                AutomationProperties.Name="排队一次提醒通道测试" />
                        <Button Content="{Binding ClearNotificationHistoryLabel}" MinHeight="36" Padding="11,5" Margin="0,0,0,5"
                                Style="{DynamicResource SecondaryButton}" Command="{Binding ClearNotificationHistoryCommand}"
                                AutomationProperties.Name="{Binding ClearNotificationHistoryLabel}" />
                    </WrapPanel>
                    <Border Background="{DynamicResource AccentTint}" BorderBrush="{DynamicResource AccentSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,4,0,0">
                        <TextBlock Text="{Binding NotificationStatus}" TextWrapping="Wrap" FontSize="11"
                                   AutomationProperties.AutomationId="NotificationStatus"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <TextBlock Text="已提交表示宿主接受了请求，不能确认你已看到。退出应用期间不会准点提醒。"
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </Expander>
</UserControl>
