<Window x:Class="AiPet.ToolWindow.PetToolWindow" x:Name="ToolWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiPet.ToolWindow"
        Title="小方工具袋"
        Width="440" Height="536" MinWidth="360"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#FF33302E"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ToolWindowTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <local:HomeViewModel x:Key="HomeVM" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="PopoverRoot" DataContext="{StaticResource HomeVM}">
        <Polygon x:Name="TopPointer" Width="24" Height="13" Points="0,12 12,0 24,12" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2"
                 Fill="{StaticResource Paper}" Stroke="#66E6DBCF" StrokeThickness="1" Visibility="Collapsed" />
        <Polygon x:Name="BottomPointer" Width="24" Height="13" Points="0,0 12,12 24,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Panel.ZIndex="2"
                 Fill="{StaticResource Paper}" Stroke="#66E6DBCF" StrokeThickness="1" Visibility="Collapsed" />

        <Border x:Name="PopoverBody" Margin="8,12" Background="{StaticResource Paper}"
                BorderBrush="#55E6DBCF" BorderThickness="1" CornerRadius="20" ClipToBounds="True"
                Effect="{StaticResource PopoverShadow}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <!-- Keep the three window actions beside the page tabs.  The
                     tab control spans both rows so its header and content
                     remain one coherent keyboard navigation surface. -->
                <Border Grid.Row="0" HorizontalAlignment="Right" Background="{StaticResource Canvas}" Panel.ZIndex="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <ToggleButton x:Name="StayOpenButton" Style="{StaticResource WindowStateButton}" Margin="2,0"
                                          IsChecked="{Binding StayOpen, ElementName=ToolWindowRoot, Mode=TwoWay}"
                                          ToolTip="常驻工具窗口：失焦时不自动收起"
                                          AutomationProperties.Name="常驻工具窗口">
                                <Path Width="14" Height="14" Data="M6,3 H14 L13,8 L16,11 V13 H11 V18 L9,20 V13 H4 V11 L7,8 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round" Stretch="Uniform" />
                            </ToggleButton>
                            <ToggleButton x:Name="AlwaysOnTopButton" Style="{StaticResource WindowStateButton}" Margin="2,0"
                                          IsChecked="{Binding AlwaysOnTop, ElementName=ToolWindowRoot, Mode=TwoWay}"
                                          ToolTip="保持窗口置顶：显示在其他普通窗口上方"
                                          AutomationProperties.Name="保持窗口置顶">
                                <Path Width="14" Height="14" Data="M3,7 H15 V17 H3 Z M7,3 H19 V13 M8,7 L11,4 L14,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                            </ToggleButton>
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="Close_Click" ToolTip="收起工具窗口 (Esc)" AutomationProperties.Name="收起工具窗口">
                                <Path Width="14" Height="14" Data="M5,5 L15,15 M15,5 L5,15" Stroke="{StaticResource Ink}" StrokeThickness="1.8" StrokeStartLineCap="Round" Stretch="Uniform" />
                            </Button>
                    </StackPanel>
                </Border>

                <TabControl x:Name="ShellTabs" Grid.RowSpan="2" Style="{StaticResource ShellTabsStyle}" Margin="18,8,18,18" SelectedIndex="0" KeyboardNavigation.TabNavigation="Local">
                    <TabItem Style="{StaticResource ShellTab}" Header="主页" PreviewMouseDown="ShellTab_PreviewMouseDown"
                             ToolTip="主页 · Alt+1 · Ctrl+L 聚焦搜索"
                             AutomationProperties.HelpText="按 Alt+1 打开主页，按 Ctrl+L 聚焦搜索">
                        <Grid>
                            <!-- Search and results are the primary task.  The
                                 remaining rows stay compact so the shortcut
                                 strip never pushes the result list away. -->
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="44" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="{StaticResource AccentTint}" CornerRadius="14" Padding="10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="176" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ListBox x:Name="SearchScopeSelector" MaxHeight="92" VerticalAlignment="Top"
                                             Style="{StaticResource InlineChoiceList}"
                                             ItemContainerStyle="{StaticResource CompactInlineChoiceItem}"
                                             ItemsSource="{Binding SearchScopes}"
                                             SelectedItem="{Binding SelectedSearchScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="直接单击范围，或使用方向键切换"
                                             AutomationProperties.AutomationId="SearchScopeSelector"
                                             AutomationProperties.Name="搜索范围选项">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" MaxWidth="132"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Column="2" VerticalAlignment="Top">
                                        <TextBox x:Name="SearchBox" Height="44" Style="{StaticResource Field}" Padding="35,0,46,0"
                                                 VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="NoWrap" AcceptsReturn="False"
                                                 ToolTip="普通文字可匹配名称、路径或已启用的受控正文；*.pdf 和 re:^报告 只匹配所选元数据字段" AutomationProperties.Name="本地搜索" />
                                        <Path Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0"
                                              Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M12.5,12.5 L17,17"
                                              Stroke="{StaticResource AccentPressed}" StrokeThickness="1.8" StrokeStartLineCap="Round" IsHitTestVisible="False" />
                                        <Button x:Name="ClearSearchButton" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                Style="{StaticResource IconButton}" Content="×" FontSize="18" Padding="0"
                                                Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding ClearSearchCommand}" Click="ClearSearch_Click"
                                                ToolTip="清空搜索并继续输入" AutomationProperties.AutomationId="ClearSearchButton" AutomationProperties.Name="清空搜索" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10"
                                    Visibility="{Binding ShowSearchOnboarding, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="首次搜索范围授权">
                                <StackPanel>
                                    <TextBlock Text="先选择允许搜索的文件夹" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="{Binding SearchPrivacyNotice}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,9" />
                                    <ItemsControl ItemsSource="{Binding SearchOnboardingCandidates}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" MinHeight="42" Margin="0,1,5,1"
                                                          AutomationProperties.Name="{Binding DisplayName}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Left" Content="隐私说明" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="11,6" Command="{Binding OpenHelpCommand}" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="稍后设置" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="11,6" Command="{Binding DeferSearchOnboardingCommand}" />
                                            <Button Content="确认并建立索引" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="13,6" Margin="7,0,0,0" Command="{Binding ConfirmSearchOnboardingCommand}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="5" Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="管理" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,6,0" Click="ManageShortcuts_Click" AutomationProperties.Name="展开快捷入口管理" />
                                        <Button Content="＋ 添加入口" Style="{StaticResource SecondaryButton}" Padding="12,7" Command="{Binding AddShortcutCommand}" AutomationProperties.Name="添加文件或应用快捷入口" />
                                        <Button Content="文件夹" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="6,0,0,0" Click="BrowseShortcutFolder_Click" AutomationProperties.Name="添加文件夹快捷入口" />
                                    </StackPanel>
                                    <TextBlock Text="快捷入口" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
                                </DockPanel>
                                <Grid MinHeight="48" MaxHeight="120" AllowDrop="True" DragOver="ShortcutBar_DragOver" Drop="ShortcutBar_Drop">
                                    <Border x:Name="ShortcutEmptyState">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Shortcuts.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Width="18" Height="18" Margin="0,0,8,0" Data="M3,5 H8 L10,7 H17 V16 H3 Z M10,10 V14 M8,12 H12"
                                                  Stroke="{StaticResource Muted}" StrokeThickness="1.5" Stretch="Uniform" />
                                            <TextBlock Text="还没有快捷入口，添加常用应用或文件" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer x:Name="ShortcutScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" MaxHeight="116" Visibility="{Binding HasShortcuts, Converter={StaticResource BoolToVisibility}}">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource CreamScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsControl x:Name="ShortcutItems" ItemsSource="{Binding Shortcuts}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid x:Name="ShortcutGridPanel" Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="48" Height="48" Margin="3" Style="{StaticResource ShortcutCard}">
                                                        <Border.ToolTip>
                                                            <ToolTip>
                                                                <StackPanel MaxWidth="300">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding TargetPath}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                        <Grid>
                                                            <Button Padding="4" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Ink}" Cursor="Hand" Command="{Binding DataContext.LaunchShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding DisplayName}">
                                                                <Image Width="30" Height="30" Source="{Binding Converter={StaticResource ShellIconConverter}}" Stretch="Uniform" SnapsToDevicePixels="True" />
                                                            </Button>
                                                            <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                                                    Background="{StaticResource Error}" CornerRadius="7"
                                                                    ToolTip="目标已失效，请打开管理菜单重新定位或移除。"
                                                                    AutomationProperties.Name="{Binding DisplayName, StringFormat=快捷入口目标已失效：{0}，请重新定位或移除}">
                                                                <Path Width="2" Height="8" Data="M1,0 V5 M1,7 V8" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" Stretch="Fill" />
                                                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ExistsNow}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                                            </Border>
                                                            <Button Content="⋯" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Foreground="{StaticResource Muted}" Cursor="Hand" Click="OpenShortcutMenu_Click" ToolTip="编辑、排序或重新定位" AutomationProperties.Name="{Binding DisplayName, StringFormat=管理快捷入口：{0}}" AutomationProperties.HelpText="打开编辑、排序、重新定位或移除操作">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Opacity" Value="0.72" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter Property="Opacity" Value="1" />
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                        <Border.ContextMenu>
                                                            <ContextMenu Opened="ShortcutMenu_Opened">
                                                                <MenuItem Header="编辑名称、描述或图标" Click="EditShortcut_Click" />
                                                                <MenuItem Header="重新定位" Click="RelocateShortcut_Click" />
                                                                <Separator />
                                                                <MenuItem Header="上移" Click="MoveShortcutUp_Click" />
                                                                <MenuItem Header="下移" Click="MoveShortcutDown_Click" />
                                                                <Separator />
                                                                <MenuItem Header="移除" Click="RemoveShortcut_Click" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="搜索结果" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
                                    <TextBlock Text="{Binding SearchResultCountText}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0" AutomationProperties.Name="搜索结果数量" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource InlineSegmentGroup}">
                                    <ListBox x:Name="CategoryFilterSelector"
                                             Style="{StaticResource InlineChoiceList}"
                                             ItemContainerStyle="{StaticResource SegmentInlineChoiceItem}"
                                             ItemsSource="{Binding Categories}"
                                             SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="CategoryFilterSelector"
                                             AutomationProperties.Name="结果类别选项">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3">
                                <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" BorderThickness="0" Background="Transparent" SelectionMode="Single" MouseDoubleClick="Results_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" ItemContainerStyle="{StaticResource ResultItem}" AutomationProperties.AutomationId="ResultsList" AutomationProperties.Name="搜索结果">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CreamScrollBar}" />
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="30" Height="30" Background="{StaticResource AccentTint}" CornerRadius="8" VerticalAlignment="Center"><Image Width="22" Height="22" Source="{Binding Converter={StaticResource ShellIconConverter}}" Stretch="Uniform" SnapsToDevicePixels="True" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding RelativePath}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding MatchSnippet}" Foreground="{StaticResource Ink}" FontSize="11" TextWrapping="Wrap" MaxHeight="34" Margin="0,3,0,1" Visibility="{Binding HasMatchSnippet, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="正文命中摘要" /><DockPanel><Button DockPanel.Dock="Right" Content="{Binding PinLabel}" Style="{StaticResource SecondaryButton}" Padding="7,3" MinHeight="28" Command="{Binding DataContext.ToggleResultPinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /><TextBlock Text="{Binding MatchReason}" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /></DockPanel></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border VerticalAlignment="Stretch" MinHeight="38">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Width="17" Height="17" Margin="0,0,8,0" Data="M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 M12.5,12.5 L17,17" Stroke="{StaticResource Accent}" StrokeThickness="1.7" Stretch="Uniform" />
                                            <TextBlock Text="{Binding ResultEmptyMessage}" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="270" />
                                        </StackPanel>
                                        <WrapPanel HorizontalAlignment="Center" Margin="0,9,0,0">
                                            <Button Content="重置搜索条件" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Margin="0,0,7,0"
                                                    Command="{Binding ResetSearchContextCommand}" Click="ClearSearch_Click"
                                                    Visibility="{Binding HasSearchConditionsToReset, Converter={StaticResource BoolToVisibility}}"
                                                    AutomationProperties.Name="重置搜索关键词、类别和范围" />
                                            <Button Content="管理搜索范围" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Click="OpenSearchSettings_Click"
                                                    AutomationProperties.Name="打开设置中的搜索范围" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Padding" Value="8" />
                                            <Style.Triggers><DataTrigger Binding="{Binding HasResults}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>

                            <Border Grid.Row="4" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="10" Padding="9,7" Margin="0,7,0,0"
                                    Visibility="{Binding HasSelectedResult, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="所选搜索结果操作">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding SelectedResultSummary}" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                                        <Button Content="打开" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="12,6" Command="{Binding OpenSelectedResultCommand}" AutomationProperties.AutomationId="OpenSelectedResultButton" AutomationProperties.Name="打开所选搜索结果" />
                                        <Button Content="定位" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Margin="6,0,0,0" Command="{Binding RevealSelectedResultCommand}" AutomationProperties.AutomationId="RevealSelectedResultButton" AutomationProperties.Name="在文件资源管理器中定位所选搜索结果" />
                                        <Button Content="复制路径" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Margin="6,0,0,0" Command="{Binding CopySelectedResultPathCommand}" AutomationProperties.AutomationId="CopySelectedResultPathButton" AutomationProperties.Name="复制所选搜索结果路径" />
                                        <Button Content="{Binding SelectedResultShortcutLabel}" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Margin="6,0,0,0" Command="{Binding AddSelectedResultToShortcutsCommand}" AutomationProperties.AutomationId="AddSelectedResultToShortcutsButton" AutomationProperties.Name="将所选搜索结果加入快捷入口" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <DockPanel Grid.Row="6" Margin="2,7,0,0"><Button DockPanel.Dock="Right" Content="继续加载" Style="{StaticResource CompactButton}" Command="{Binding LoadMoreResultsCommand}" Visibility="{Binding HasMoreResults, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="加载更多搜索结果" /><Ellipse Width="6" Height="6" Margin="0,0,7,0" Fill="{StaticResource Accent}" VerticalAlignment="Center" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></DockPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource ShellTab}" Header="待办" PreviewMouseDown="ShellTab_PreviewMouseDown"
                             ToolTip="待办 · Alt+2 · Ctrl+N 快速新建"
                             AutomationProperties.HelpText="按 Alt+2 打开待办，按 Ctrl+N 快速新建待办">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                      DataContext="{Binding Todo}" AutomationProperties.Name="待办与提醒页">
                            <Grid Margin="0,0,8,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="3" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,10">
                                    <Expander x:Name="TodoAiExpander" AutomationProperties.Name="一句话 AI 安排">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="IsExpanded" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAiError}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding NeedsAiClarification}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding HasAiDraft}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <Expander.Header>
                                            <StackPanel>
                                                <TextBlock Text="一句话安排（AI 可选）" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                                <TextBlock Text="展开后输入自然语言，确认草稿前不会写入" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Expander.Header>
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="例如：明天下午 3 点提醒我提交周报" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,9" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="TodoAiInputBox" Height="44" Style="{StaticResource Field}"
                                                     Foreground="{StaticResource Ink}"
                                                     Text="{Binding AiInput, UpdateSourceTrigger=PropertyChanged}"
                                                     PreviewKeyDown="TodoAiInput_KeyDown"
                                                     ToolTip="输入一句完整的待办或提醒"
                                                     AutomationProperties.Name="AI 待办自然语言输入" />
                                            <Button Grid.Column="2" Content="{Binding AiParseButtonLabel}" Style="{StaticResource PrimaryButton}" MinWidth="86"
                                                    Command="{Binding ParseAiCommand}" AutomationProperties.Name="生成待办草稿" />
                                        </Grid>
                                        <TextBlock Text="{Binding AiMessage}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="1,8,0,0" AutomationProperties.Name="AI 待办状态" AutomationProperties.LiveSetting="Polite" />

                                        <Border Background="#FFFFF3F0" BorderBrush="#55AE4F4F" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,9,0,0"
                                                Visibility="{Binding HasAiError, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AiError}" Foreground="{StaticResource Error}" TextWrapping="Wrap" FontSize="12" AutomationProperties.Name="AI 待办错误" AutomationProperties.LiveSetting="Polite" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="重试" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding ParseAiCommand}" />
                                                    <Button Content="转手动填写" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Margin="7,0,0,0" Command="{Binding UseManualCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,9,0,0"
                                                Visibility="{Binding NeedsAiClarification, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <TextBlock Text="需要补充" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AiClarification}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" AutomationProperties.Name="AI 待办需要补充的信息" AutomationProperties.LiveSetting="Polite" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="转手动填写" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding UseManualCommand}" />
                                                    <Button Content="清除 AI 内容" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Margin="7,0,0,0" Command="{Binding ClearAiCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,9,0,0"
                                                Visibility="{Binding HasAiDraft, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="确认前未写入" Foreground="{StaticResource Success}" FontSize="11" />
                                                    <TextBlock Text="{Binding AiOperationText}" FontWeight="SemiBold" FontSize="14" />
                                                </DockPanel>
                                                <Grid Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Text="标题" Foreground="{StaticResource Muted}" /><TextBlock Grid.Column="1" Text="{Binding AiDraftTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Text="截止" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AiDraftDueText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="2" Text="提醒" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AiDraftReminderText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="3" Text="时区" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AiTimeZoneText}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="4" Text="备注" Foreground="{StaticResource Muted}" Margin="0,5,0,0" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AiDraftNotes}" Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="54" />
                                                </Grid>
                                                <StackPanel Margin="0,9,0,0" Visibility="{Binding NeedsAiTarget, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="选择唯一待办" Style="{StaticResource SectionLabel}" />
                                                    <Border Style="{StaticResource InlineChoiceSurface}">
                                                        <ListBox x:Name="AiTargetSelector" MaxHeight="144"
                                                                 Style="{StaticResource InlineChoiceList}"
                                                                 ItemContainerStyle="{StaticResource InlineChoiceRowItem}"
                                                                 ItemsSource="{Binding AiTargetChoices}" DisplayMemberPath="TargetChoiceText"
                                                                 SelectedItem="{Binding SelectedAiTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="AiTargetSelector"
                                                                 AutomationProperties.Name="AI 操作目标列表" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding AiChangeSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                    <Button Content="取消" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="13,6" Command="{Binding CancelAiCommand}" />
                                                    <Button Content="转手动" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="13,6" Margin="7,0,0,0" Command="{Binding UseManualCommand}" />
                                                    <Button Content="确认执行" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="13,6" Margin="7,0,0,0" Command="{Binding ConfirmAiCommand}" AutomationProperties.Name="确认 AI 待办操作" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    </Expander>
                                </Border>

                                <local:NotificationInbox Grid.Row="4" Margin="0,0,0,12" />
                                <Border Grid.Row="5" Background="#FFF2F7F3" BorderBrush="#554F7A60" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,0,0,10"
                                        Visibility="{Binding HasReminderAlert, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="到期待办提醒" AutomationProperties.LiveSetting="Polite">
                                    <StackPanel>
                                        <TextBlock Text="提醒到期" Foreground="{StaticResource Success}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ReminderAlertTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding ReminderAlertMessage}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Button Content="完成" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="13,6" Command="{Binding CompleteReminderAlertCommand}" />
                                            <Button Content="10 分钟后" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="13,6" Margin="7,0,0,0" Command="{Binding SnoozeReminderAlertCommand}" />
                                            <Button Content="打开详情" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="13,6" Margin="7,0,0,0" Command="{Binding OpenReminderAlertCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="0" Margin="1,0,0,9">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button x:Name="NewTodoButton" DockPanel.Dock="Right" Content="＋ 新建待办" Style="{StaticResource PrimaryButton}" MinHeight="38" Padding="12,7" Command="{Binding NewTodoCommand}" Click="NewTodo_Click" AutomationProperties.Name="新建待办" />
                                        <StackPanel>
                                            <TextBlock Text="待办清单" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="重复与多次提醒 · 本地保存" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Grid.Row="1" Margin="0,7,0,0" Style="{StaticResource InlineSegmentGroup}">
                                        <ListBox x:Name="TodoFilterSelector"
                                                 Style="{StaticResource InlineChoiceList}"
                                                 ItemContainerStyle="{StaticResource SegmentInlineChoiceItem}"
                                                 ItemsSource="{Binding Filters}" DisplayMemberPath="DisplayName"
                                                 SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="TodoFilterSelector"
                                                 AutomationProperties.Name="待办日期筛选选项">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>
                                    </Border>
                                    <TextBlock Grid.Row="2" Text="{Binding FilterSummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="1,6,0,0" AutomationProperties.Name="当前待办筛选数量" AutomationProperties.LiveSetting="Polite" />
                                </Grid>

                                <Border Grid.Row="6" Style="{StaticResource SectionCard}" Margin="0,0,0,10">
                                    <Expander x:Name="TodayPlanExpander" AutomationProperties.Name="今日安排">
                                        <Expander.Style>
                                            <Style TargetType="Expander">
                                                <Setter Property="IsExpanded" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTodayPlanDraft}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding HasTodayPlanError}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Expander.Style>
                                        <Expander.Header>
                                            <DockPanel MinWidth="330">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TodayPlanSelectedCount, StringFormat=已选 {0}/12}" Foreground="{StaticResource AccentPressed}" FontSize="11" VerticalAlignment="Center" AutomationProperties.Name="今日安排已选数量" AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Text="今日安排" FontSize="15" FontWeight="SemiBold" />
                                            </DockPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                        <TextBlock Text="只会把你勾选的标题、备注和时间发送给当前 AI 配置；未勾选事项仅提供匿名占用时间用于避让，本地安排不访问网络。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <Border Style="{StaticResource InlineChoiceSurface}" MaxHeight="190" Visibility="{Binding HasTodayPlanCandidates, Converter={StaticResource BoolToVisibility}}">
                                            <ListBox x:Name="TodayPlanCandidateSelector" ItemsSource="{Binding TodayPlanCandidates}" Background="Transparent" BorderThickness="0" SelectionMode="Multiple"
                                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                      AutomationProperties.AutomationId="TodayPlanCandidateSelector"
                                                      AutomationProperties.Name="今日安排候选事项">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource InlineChoiceRowItem}">
                                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="7,6" AutomationProperties.Name="{Binding Title, StringFormat=今日安排候选 {0}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding ScheduleText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                        <TextBlock Text="没有待处理事项可安排。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasTodayPlanCandidates}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,9,0,0">
                                            <Button Content="选择前 12 条" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding SelectFirstTodayPlanCandidatesCommand}" Margin="0,0,7,6" AutomationProperties.Name="选择今日安排列表中的前十二条事项" />
                                            <Button Content="清除选择" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding ClearTodayPlanSelectionCommand}" Margin="0,0,7,6" AutomationProperties.Name="清除今日安排事项选择" />
                                            <Button Content="{Binding TodayPlanAiButtonLabel}" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="12,6" Command="{Binding GenerateAiTodayPlanCommand}" Margin="0,0,7,6" AutomationProperties.Name="生成 AI 今日安排" />
                                            <Button Content="本地安排" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding GenerateLocalTodayPlanCommand}" Margin="0,0,7,6" AutomationProperties.AutomationId="GenerateLocalTodayPlanButton" />
                                            <Button Content="{Binding TodayPlanUndoLabel}" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding UndoTodayPlanCommand}" Margin="0,0,0,6" Visibility="{Binding CanUndoTodayPlan, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="UndoTodayPlanButton" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding TodayPlanMessage}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Text="{Binding TodayPlanError}" Foreground="{StaticResource Error}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasTodayPlanError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="今日安排错误" AutomationProperties.LiveSetting="Polite" />

                                        <StackPanel Margin="0,9,0,0" Visibility="{Binding HasTodayPlanDraft, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="安排草稿 · 取消勾选可排除单项" Style="{StaticResource SectionLabel}" />
                                            <ItemsControl ItemsSource="{Binding TodayPlanDraft}" Margin="0,5,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                                            <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" AutomationProperties.Name="{Binding Title, StringFormat=今日安排草稿 {0}}">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Foreground="{StaticResource AccentPressed}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="取消草稿" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding CancelTodayPlanCommand}" />
                                                <Button Content="确认应用所选" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="12,6" Margin="7,0,0,0" Command="{Binding ApplyTodayPlanCommand}" AutomationProperties.Name="确认应用今日安排" AutomationProperties.AutomationId="ApplyTodayPlanButton" />
                                            </StackPanel>
                                        </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,10" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding EditorStateHint}" Foreground="{StaticResource Muted}" FontSize="10" Margin="8,2,0,0" MaxWidth="205" TextWrapping="Wrap" TextAlignment="Right" AutomationProperties.Name="待办编辑状态" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Text="{Binding EditorHeading}" FontSize="15" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="标题" Style="{StaticResource SectionLabel}" Margin="0,10,0,7" />
                                        <TextBox x:Name="TodoTitleBox" Style="{StaticResource Field}" Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="待办标题" />
                                        <TextBlock Text="备注（可选）" Style="{StaticResource SectionLabel}" Margin="0,10,0,7" />
                                        <TextBox Style="{StaticResource Field}" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                 Text="{Binding EditorNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="待办备注" />
                                        <CheckBox x:Name="EditorIsReminderToggle" Content="这是提醒项（最后一次投递后自动完成）"
                                                  IsChecked="{Binding EditorIsReminder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,10,0,0" AutomationProperties.Name="设置为提醒项" />
                                        <StackPanel Visibility="{Binding EditorReminderOptionsVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                                            <TextBlock Text="桌宠提醒方式（可多选）" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,2" />
                                            <CheckBox x:Name="EditorReminderRoamToggle" Content="桌宠漫游提醒" IsChecked="{Binding EditorReminderRoamEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="启用桌宠漫游提醒" />
                                            <CheckBox x:Name="EditorReminderBubbleToggle" Content="桌宠气泡提醒" IsChecked="{Binding EditorReminderBubbleEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="启用桌宠气泡提醒" />
                                        </StackPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock Text="截止日期" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Grid.Column="3" Text="提醒日期" Style="{StaticResource SectionLabel}" />
                                            <DatePicker Grid.Row="1" Height="40" SelectedDate="{Binding EditorDueDate, Mode=TwoWay}" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" AutomationProperties.Name="截止日期" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Height="40" Style="{StaticResource Field}" Margin="6,0,0,0" Text="{Binding EditorDueTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="HH:mm" AutomationProperties.Name="截止时间" />
                                            <DatePicker Grid.Row="1" Grid.Column="3" Height="40" SelectedDate="{Binding EditorReminderDate, Mode=TwoWay}" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" AutomationProperties.Name="提醒日期" />
                                            <TextBox Grid.Row="1" Grid.Column="4" Height="40" Style="{StaticResource Field}" Margin="6,0,0,0" Text="{Binding EditorReminderTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="HH:mm" AutomationProperties.Name="提醒时间" />
                                        </Grid>
                                        <TextBlock Text="时间使用 24 小时 HH:mm；提醒按下方时区解释，截止时间使用当前时区。不选择日期表示不设置。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.Name="日期和时间填写说明" />
                                        <Expander Header="重复与额外提醒" Margin="0,10,0,0">
                                            <StackPanel>
                                                <ListBox ItemsSource="{Binding RecurrenceOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding EditorRecurrence}" Style="{StaticResource InlineChoiceList}" ItemContainerStyle="{StaticResource SegmentInlineChoiceItem}" AutomationProperties.Name="重复规则">
                                                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                </ListBox>
                                                <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,6">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,10,0" ToolTip="自选星期规则使用这些日期" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="间隔（每天按天，其余按周；1–365）" Style="{StaticResource SectionLabel}" />
                                                <TextBox Text="{Binding EditorInterval, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Style="{StaticResource Field}" AutomationProperties.Name="重复间隔" />
                                                <TextBlock Text="结束日期（留空为持续重复）" Style="{StaticResource SectionLabel}" />
                                                <DatePicker SelectedDate="{Binding EditorEndsOn}" AutomationProperties.Name="重复结束日期" />
                                                <TextBlock Text="固定当地时间所属时区" Style="{StaticResource SectionLabel}" />
                                                <ListBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding EditorTimeZoneId}" MaxHeight="95" Style="{StaticResource InlineChoiceList}" ItemContainerStyle="{StaticResource InlineChoiceRowItem}" AutomationProperties.Name="提醒时区" />
                                                <TextBlock Text="额外时间（每行 yyyy-MM-dd HH:mm，最多 32 次）" Style="{StaticResource SectionLabel}" TextWrapping="Wrap" />
                                                <TextBox Text="{Binding EditorAdditionalTimes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" MaxHeight="120" VerticalScrollBarVisibility="Auto" Style="{StaticResource Field}" AutomationProperties.Name="额外提醒时间" />
                                                <CheckBox Content="仅调整此次时间（保留标题和整个规则）" IsChecked="{Binding EditorOnlyThis}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding EditorRecurrencePreview}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8" AutomationProperties.Name="下次提醒预览" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="{Binding EditorError}" Foreground="{StaticResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                                        <Border Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,9,0,0"
                                                Visibility="{Binding ShowDiscardEditorConfirmation, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="确认放弃未保存的待办修改" AutomationProperties.LiveSetting="Polite">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                                    <Button Content="继续编辑" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="12,6" Command="{Binding KeepEditingCommand}" AutomationProperties.Name="继续编辑并保留当前修改" />
                                                    <Button Content="放弃修改" Style="{StaticResource DangerSecondaryButton}" MinHeight="36" Padding="12,6" Margin="7,0,0,0" Command="{Binding DiscardEditorCommand}" Click="TodoEditorClose_Click" AutomationProperties.Name="放弃未保存的待办修改" />
                                                </StackPanel>
                                                <TextBlock Text="当前修改尚未保存。" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,11,0,0">
                                            <Button Content="取消" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="14,7" Command="{Binding CancelEditorCommand}" Click="TodoEditorClose_Click" AutomationProperties.Name="取消待办编辑" />
                                            <Button Content="{Binding EditorSaveLabel}" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="14,7" Margin="7,0,0,0" Command="{Binding SaveEditorCommand}" Click="TodoEditorClose_Click" AutomationProperties.Name="保存待办" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Padding="18" Margin="0,0,0,10">
                                    <StackPanel HorizontalAlignment="Center" MaxWidth="280">
                                        <Path Width="28" Height="28" Data="M4,7 H20 V21 H4 Z M8,3 V9 M16,3 V9 M8,13 H16 M8,17 H13" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Stretch="Uniform" />
                                        <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <Button Content="{Binding EmptyActionLabel}" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Command="{Binding EmptyStateCommand}" Click="NewTodo_Click" AutomationProperties.Name="待办空状态主要操作" />
                                    </StackPanel>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding HasItems}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,1,0,0" />
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding ItemTypeText}" Foreground="{StaticResource AccentPressed}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding PlannedBlockText}" Foreground="{StaticResource Success}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="{Binding HasPlannedBlock, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding Notes}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" MaxHeight="40" Margin="0,3,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <TextBlock Text="{Binding DueText}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                        <TextBlock Text=" · " Foreground="{StaticResource Muted}" FontSize="11" />
                                                        <TextBlock Text="{Binding ReminderText}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                        <TextBlock Text="{Binding RepeatText, StringFormat= · {0}}" Foreground="{StaticResource Muted}" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ReminderChannelText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" Visibility="{Binding IsReminder, Converter={StaticResource BoolToVisibility}}" />
                                                    <WrapPanel Margin="0,9,0,0">
                                                        <Button Content="完成" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                                                Command="{Binding DataContext.Todo.CompleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="完成待办">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                        </Button>
                                                        <Button Content="恢复" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                                                Command="{Binding DataContext.Todo.RestoreTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="恢复已完成待办">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanRestore}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                        </Button>
                                                        <Button Content="编辑" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="11,5" Margin="0,0,6,5" Command="{Binding DataContext.Todo.EditTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="编辑待办" />
                                                        <Button Content="10 分钟后" MinHeight="36" Padding="11,5" Margin="0,0,6,5" Command="{Binding DataContext.Todo.SnoozeTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="将待办提醒推迟十分钟">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                        </Button>
                                                        <Button Content="跳过此次" MinHeight="36" Padding="11,5" Margin="0,0,6,5" Style="{StaticResource SecondaryButton}" Visibility="{Binding CanSkipOccurrence, Converter={StaticResource BoolToVisibility}}" Command="{Binding DataContext.Todo.SkipOccurrenceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="跳过本次待办提醒" />
                                                        <Button Content="取消整个提醒规则" MinHeight="36" Padding="11,5" Margin="0,0,6,5" Command="{Binding DataContext.Todo.CancelReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" AutomationProperties.Name="取消整个待办提醒规则">
                                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanCancelReminder}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                        </Button>
                                                        <Button Content="删除" Style="{StaticResource DangerSecondaryButton}" MinHeight="36" Padding="11,5" Margin="0,0,6,5"
                                                                Command="{Binding DataContext.Todo.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                                                                AutomationProperties.Name="删除待办，可在本次运行中撤销" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Grid.Row="7" Margin="1,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="{Binding UndoLabel}" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="11,5" Command="{Binding UndoLastActionCommand}" Visibility="{Binding CanUndoLastAction, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="撤销最近一次待办操作" />
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="待办操作状态" AutomationProperties.LiveSetting="Polite" />
                                </DockPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Style="{StaticResource ShellTab}" Header="维护" PreviewMouseDown="ShellTab_PreviewMouseDown"
                             ToolTip="维护 · Alt+3"
                             AutomationProperties.HelpText="按 Alt+3 打开维护页">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,9,4">
                                <TextBlock Text="本地数据与诊断" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="所有操作均在本机完成；备份与诊断不会导出 API Key。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14" />
                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="备份与恢复" Style="{StaticResource SectionLabel}" /><TextBlock Text="可选择设置、窗口位置、待办/提醒、快捷入口/图标、Provider 预设与诊断日志；不含 API Key 和可重建索引。恢复前会明确确认，不会操作快捷项指向的原文件。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" /><WrapPanel><Button x:Name="MaintenancePrimaryButton" Content="导出备份" Style="{StaticResource PrimaryButton}" Click="BackupData_Click" Margin="0,0,8,8" AutomationProperties.Name="导出本地数据备份" /><Button Content="选择备份恢复" Style="{StaticResource SecondaryButton}" Click="RestoreData_Click" Margin="0,0,0,8" AutomationProperties.Name="选择并验证本地数据备份以恢复" /></WrapPanel></StackPanel></Border>
                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="每日自动备份" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="每天最多创建一次本地备份；包含设置、窗口位置、待办、提醒和快捷入口，不含 API Key、搜索索引或日志。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <CheckBox Content="启用每日自动备份" IsChecked="{Binding AutomaticBackupEnabled, Mode=TwoWay}" MinHeight="40" AutomationProperties.Name="启用每日自动备份" />
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="保留份数" VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Height="40" MaxLength="2" Text="{Binding AutomaticBackupRetentionText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自动备份保留份数" />
                                            <TextBlock Grid.Column="2" Text="1–30" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                        <WrapPanel>
                                            <Button Content="{Binding AutomaticBackupSaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAutomaticBackupSettingsCommand}" Margin="0,0,8,8" AutomationProperties.Name="保存自动备份设置" />
                                            <Button Content="立即创建" Style="{StaticResource SecondaryButton}" Command="{Binding CreateAutomaticBackupNowCommand}" Margin="0,0,8,8" AutomationProperties.Name="立即创建每日自动备份" />
                                            <Button Content="打开备份文件夹" Style="{StaticResource SecondaryButton}" Command="{Binding OpenAutomaticBackupDirectoryCommand}" Margin="0,0,0,8" AutomationProperties.Name="打开自动备份文件夹" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding AutomaticBackupStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,12"><StackPanel><TextBlock Text="隐私安全诊断" Style="{StaticResource SectionLabel}" /><TextBlock Text="只包含版本、系统、主题、模块数量、Provider 标识、连接状态和稳定错误代码。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" /><Button Content="导出诊断 JSON" Style="{StaticResource SecondaryButton}" Click="ExportDiagnostics_Click" HorizontalAlignment="Left" AutomationProperties.Name="导出不含敏感正文的诊断 JSON" /></StackPanel></Border>
                                <Border Style="{StaticResource SectionCard}" Margin="0,0,0,10"><StackPanel><TextBlock Text="缓存清理" Style="{StaticResource SectionLabel}" /><TextBlock Text="清理可重建的搜索索引、无引用图标缓存与诊断日志；应用会退出并在下次启动时重建。设置、待办、快捷入口和凭据不受影响。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" /><Button Content="退出并重建缓存" Style="{StaticResource DangerSecondaryButton}" Click="ResetCaches_Click" HorizontalAlignment="Left" AutomationProperties.Name="退出应用并重建可恢复缓存" /></StackPanel></Border>
                                <Border Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="10" Padding="10,8" AutomationProperties.Name="维护操作状态">
                                    <TextBlock Text="{Binding MaintenanceStatus}" Foreground="{StaticResource Ink}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Style="{StaticResource ShellTab}" Header="设置" PreviewMouseDown="ShellTab_PreviewMouseDown"
                             ToolTip="设置 · Alt+4 · F1 打开手册"
                             AutomationProperties.HelpText="按 Alt+4 打开设置，按 F1 打开离线用户手册">
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="设置内容">
                            <StackPanel Margin="0,0,9,4">
                                <Border Style="{StaticResource InlineSegmentGroup}" Margin="0,0,0,12">
                                    <ListBox x:Name="SettingsSectionSelector" SelectedIndex="0"
                                             Style="{StaticResource InlineChoiceList}"
                                             ItemContainerStyle="{StaticResource SegmentInlineChoiceItem}"
                                             SelectionChanged="SettingsSectionSelector_SelectionChanged"
                                             AutomationProperties.Name="设置分组目录"
                                             AutomationProperties.HelpText="使用方向键选择，再进入对应设置分组">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBoxItem Content="外观" Tag="appearance" />
                                        <ListBoxItem Content="快捷键" Tag="hotkeys" />
                                        <ListBoxItem Content="更新" Tag="updates" />
                                        <ListBoxItem Content="搜索" Tag="search" />
                                        <ListBoxItem Content="AI" Tag="ai" />
                                    </ListBox>
                                </Border>
                                <Border x:Name="AppearanceSettingsSection" Style="{StaticResource SectionCard}" Margin="0,0,0,12" AutomationProperties.Name="外观设置分组">
                                    <StackPanel>
                                        <TextBlock Text="桌宠形象" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="选择后立即应用 · RGS CC0 角色资源" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10" />
                                        <ListBox x:Name="CharacterList" Style="{StaticResource InlineChoiceList}" ItemContainerStyle="{StaticResource InlineChoiceItem}" ItemsSource="{Binding PetCharacters}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SelectedCharacter, Mode=TwoWay}" AutomationProperties.Name="桌宠预设形象">
                                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        </ListBox>
                                        <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" Command="{Binding ToggleAutostartCommand}" Margin="0,3,0,0" />
                                        <TextBlock Text="外观与动态效果" Style="{StaticResource SectionLabel}" Margin="0,14,0,7" />
                                        <Border Style="{StaticResource InlineSegmentGroup}">
                                            <ListBox x:Name="ThemeSelector" Style="{StaticResource InlineChoiceList}" ItemContainerStyle="{StaticResource SegmentInlineChoiceItem}" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ThemeSelector" AutomationProperties.Name="应用主题选项">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                            </ListBox>
                                        </Border>
                                        <CheckBox Content="允许桌宠漫游" IsChecked="{Binding EnablePetRoaming, Mode=TwoWay}" MinHeight="36" />
                                        <CheckBox Content="允许提醒气泡动画" IsChecked="{Binding EnableBubbleAnimation, Mode=TwoWay}" MinHeight="36" />
                                        <CheckBox Content="允许朝向跟随鼠标" IsChecked="{Binding EnableFollowMotion, Mode=TwoWay}" MinHeight="36" />
                                        <TextBlock Text="系统关闭动画或启用高对比度时，应用会自动采用更克制的反馈。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="HotkeySettingsSection" Style="{StaticResource SectionCard}" Margin="0,0,0,12" AutomationProperties.Name="快捷键设置分组">
                                    <StackPanel>
                                        <TextBlock Text="快捷唤出" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="在其他窗口中直接打开搜索或新建待办。应用只注册这两个组合键，不监听其他按键。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <CheckBox x:Name="HotkeyEnabledToggle" Content="启用全局快捷键" IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}" MinHeight="40" AutomationProperties.Name="启用全局快捷键" />
                                        <TextBlock Text="打开搜索" Style="{StaticResource SectionLabel}" Margin="0,6,0,7" />
                                        <TextBox Style="{StaticResource Field}" Height="40" MaxLength="80" Text="{Binding SearchHotkeyGesture, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 Ctrl+Alt+Space" AutomationProperties.Name="打开搜索快捷键" />
                                        <TextBlock Text="快速记待办" Style="{StaticResource SectionLabel}" Margin="0,10,0,7" />
                                        <TextBox Style="{StaticResource Field}" Height="40" MaxLength="80" Text="{Binding QuickTodoHotkeyGesture, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 Ctrl+Alt+T" AutomationProperties.Name="快速记待办快捷键" />
                                        <Button Content="{Binding GlobalHotkeySaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveGlobalHotkeysCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.Name="保存并应用全局快捷键" />
                                        <TextBlock Text="{Binding GlobalHotkeyStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="UpdateSettingsSection" Style="{StaticResource SectionCard}" Margin="0,0,0,12" AutomationProperties.Name="更新设置分组">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="9" Padding="9,4">
                                                <TextBlock Text="GitHub Release" Foreground="{StaticResource AccentPressed}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="应用更新" Style="{StaticResource SectionLabel}" />
                                        </DockPanel>
                                        <TextBlock Text="每次正式启动检查一次；失败不会阻止桌宠启动，也不会自动下载安装。应用会自动选择 GitHub 官方或内置加速线路。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <Border x:Name="SmartUpdateRouteStatus" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,9" AutomationProperties.Name="智能更新线路状态">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="{StaticResource Card}" CornerRadius="8" Padding="8,3" Margin="8,0,0,0">
                                                    <TextBlock Text="自动" Foreground="{StaticResource AccentPressed}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding UpdateRouteStatus}" Foreground="{StaticResource Ink}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                            </DockPanel>
                                        </Border>
                                        <CheckBox x:Name="PeriodicUpdateCheckToggle" Content="运行期间周期检查" IsChecked="{Binding PeriodicUpdateChecksEnabled, Mode=TwoWay}" MinHeight="40" AutomationProperties.Name="运行期间周期检查更新" />
                                        <Grid Margin="0,2,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="检查周期" VerticalAlignment="Center" Margin="0,0,9,0" />
                                            <TextBox Grid.Column="1" Style="{StaticResource Field}" Height="40" MaxLength="3" IsEnabled="{Binding PeriodicUpdateChecksEnabled}" Text="{Binding UpdateIntervalHoursText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="更新检查周期小时" AutomationProperties.HelpText="开启运行期间周期检查后可设置 1 到 168 小时" />
                                            <TextBlock Grid.Column="2" Text="小时 · 1–168" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                        <WrapPanel>
                                            <Button x:Name="CheckForUpdatesButton" Content="立即检查" Style="{StaticResource PrimaryButton}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,8" Visibility="{Binding HasNoAvailableUpdate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="立即检查应用更新" />
                                            <Button Content="{Binding UpdateDownloadLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadUpdateCommand}" Margin="0,0,8,8" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="下载并准备安装更新" />
                                            <Button Content="重新检查" Style="{StaticResource SecondaryButton}" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,8" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="重新检查应用更新" />
                                            <Button Content="{Binding UpdateSettingsSaveLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding SaveUpdateSettingsCommand}" Margin="0,0,0,8" AutomationProperties.Name="保存更新检查设置" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SearchSettingsSection" Style="{StaticResource SectionCard}" Margin="0,0,0,12" AutomationProperties.Name="搜索设置分组">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="＋ 添加文件夹" Style="{StaticResource SecondaryButton}" Padding="14,7" Click="BrowseRange_Click" />
                                            <StackPanel><TextBlock Text="搜索范围" Style="{StaticResource SectionLabel}" Margin="0" /><TextBlock Text="只索引你明确允许的文件夹" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource EmptyState}" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="尚未添加文件夹" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRanges}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                <ItemsControl ItemsSource="{Binding Ranges}" Visibility="{Binding HasRanges, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Path}" />
                                                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite" />
                                                                        <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,9,0,0">
                                                                        <Button Content="取消" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="10,5" Margin="0,0,6,0"
                                                                                Command="{Binding DataContext.CancelRangeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                                                                                Visibility="{Binding IsPreparing, Converter={StaticResource BoolToVisibility}}" />
                                                                        <Button Content="{Binding PrimaryActionLabel}" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="10,5" Margin="0,0,6,0"
                                                                                Command="{Binding DataContext.RetryRangeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}"
                                                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                                                        <Button Content="移除" Style="{StaticResource SecondaryButton}" MinHeight="36" Padding="10,5" Foreground="{StaticResource Error}"
                                                                                Command="{Binding DataContext.RemoveRangeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" />
                                                                    </WrapPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                        <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="文件正文搜索（可选）" FontWeight="SemiBold" FontSize="12" />
                                                <CheckBox x:Name="ContentSearchToggle" Content="读取授权范围内的受控文本正文" IsChecked="{Binding EnableContentSearch, Mode=TwoWay}" MinHeight="40" Margin="0,4,0,0" AutomationProperties.AutomationId="ContentSearchToggle" AutomationProperties.Name="启用受控文件正文搜索" />
                                                <TextBlock Text="只处理不超过 128 KiB 的 .txt 和 .md，支持严格 UTF-8 与带 BOM 的 UTF-16；索引只保存在本机，停用会立即清除。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding ContentSearchStatus}" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Button Content="重建正文索引" Style="{StaticResource SecondaryButton}" MinHeight="40" Command="{Binding RebuildContentIndexCommand}" Margin="0,0,7,0" AutomationProperties.Name="重建所有授权范围的正文索引" />
                                                    <Button Content="停用并清除" Style="{StaticResource SecondaryButton}" MinHeight="40" Command="{Binding DisableContentSearchCommand}" AutomationProperties.Name="停用正文搜索并清除本地正文索引" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="文件名匹配方式" FontWeight="SemiBold" FontSize="12" />
                                        <CheckBox x:Name="WildcardSearchToggle" Content="启用 * 和 ? 通配符" IsChecked="{Binding EnableWildcardSearch, Mode=TwoWay}" MinHeight="40" Margin="0,5,0,0" AutomationProperties.Name="启用文件名通配符搜索" />
                                        <CheckBox x:Name="RegexSearchToggle" Content="启用 re: 正则表达式" IsChecked="{Binding EnableRegexSearch, Mode=TwoWay}" MinHeight="40" AutomationProperties.Name="启用文件名正则表达式搜索" />
                                        <ListBox ItemsSource="{Binding SearchFields}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSearchField}" Style="{StaticResource InlineChoiceList}" ItemContainerStyle="{StaticResource SegmentInlineChoiceItem}" AutomationProperties.Name="搜索匹配字段">
                                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        </ListBox>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="{Binding SearchHistoryLabel}" Style="{StaticResource SecondaryButton}" Click="ToggleSearchHistory_Click" Margin="0,0,6,6" />
                                            <Button Content="清除最近使用记录" Style="{StaticResource SecondaryButton}" Command="{Binding ClearSearchHistoryCommand}" Margin="0,0,0,6" />
                                        </WrapPanel>
                                        <TextBlock Text="普通文字按所选元数据字段搜索，并在启用时补充正文；通配符和正则只处理元数据。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AiSettingsSection" Style="{StaticResource SectionCard}" Margin="0,0,0,12" AutomationProperties.Name="AI 设置分组">
                                    <Expander x:Name="AiSettingsExpander" AutomationProperties.Name="AI 接入设置">
                                        <Expander.Header><TextBlock Text="AI 接入（可选）" FontWeight="SemiBold" /></Expander.Header>
                                        <StackPanel Margin="0,12,0,0">
                                             <TextBlock Text="新建配置模板" Style="{StaticResource SectionLabel}" />
                                             <ListBox x:Name="AiTemplateSelector" Style="{StaticResource InlineChoiceList}" ItemContainerStyle="{StaticResource InlineChoiceItem}" ItemsSource="{Binding AiConfigurationTemplates}" SelectedItem="{Binding SelectedAiTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AiTemplateSelector" AutomationProperties.Name="新建 AI 配置模板选项">
                                                 <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                 <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
                                             </ListBox>
                                             <Button Content="从所选模板新建" Style="{StaticResource SecondaryButton}" Click="NewAiConfig_Click" Margin="0,7,0,0" HorizontalAlignment="Right" AutomationProperties.Name="从模板新建 AI 配置" />
                                             <TextBlock Text="{Binding SelectedAiTemplate.Notes}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                             <TextBlock Text="已保存配置" Style="{StaticResource SectionLabel}" Margin="0,12,0,7" />
                                             <Border Style="{StaticResource InlineChoiceSurface}" MinHeight="44">
                                                 <ListBox x:Name="SavedAiConfigurationSelector" MaxHeight="144"
                                                          Style="{StaticResource InlineChoiceList}"
                                                          ItemContainerStyle="{StaticResource InlineChoiceRowItem}"
                                                          ItemsSource="{Binding SavedAiConfigurations}" DisplayMemberPath="DisplayName"
                                                          SelectedItem="{Binding SelectedAiConfiguration, Mode=OneWay}"
                                                          SelectionChanged="SavedAiConfigurationSelector_SelectionChanged"
                                                          IsEnabled="{Binding HasSavedAiConfigurations}"
                                                          AutomationProperties.AutomationId="SavedAiConfigurationSelector"
                                                          AutomationProperties.Name="已保存 AI 配置列表" />
                                             </Border>
                                             <TextBlock Text="选择已保存配置后会立即作为待办 AI 的当前配置。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                             <TextBlock Text="配置名称" Style="{StaticResource SectionLabel}" Margin="0,12,0,7" />
                                             <TextBox x:Name="AiConfigurationNameBox" Style="{StaticResource Field}" Text="{Binding AiConfigurationName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="AI 配置名称" />
                                             <TextBlock Text="供应商" Style="{StaticResource SectionLabel}" Margin="0,12,0,7" />
                                             <ListBox x:Name="ProviderSelector" Style="{StaticResource InlineChoiceList}" ItemContainerStyle="{StaticResource InlineChoiceItem}" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProviderSelector" AutomationProperties.Name="AI 供应商选项">
                                                 <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                 <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate></ListBox.ItemTemplate>
                                             </ListBox>
                                            <TextBlock Text="服务地址" Style="{StaticResource SectionLabel}" Margin="0,12,0,7" /><TextBox x:Name="EndpointBox" Style="{StaticResource Field}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="AI 服务地址" />
                                            <TextBlock Text="模型" Style="{StaticResource SectionLabel}" Margin="0,12,0,7" /><TextBox x:Name="ModelBox" Style="{StaticResource Field}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="AI 模型" />
                                            <TextBlock Text="API Key" Style="{StaticResource SectionLabel}" Margin="0,12,0,7" /><Border Style="{StaticResource FieldChrome}"><PasswordBox x:Name="ApiKeyBox" Style="{StaticResource BarePasswordBox}" PasswordChanged="ApiKeyBox_PasswordChanged" AutomationProperties.Name="AI API Key" /></Border>
                                            <TextBlock Text="{Binding AiActionHint}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                            <DockPanel Margin="0,14,0,0">
                                                <Button DockPanel.Dock="Left" Content="删除当前配置" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource Error}" Click="DeleteAiConfig_Click" Visibility="{Binding HasSelectedAiConfiguration, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="删除当前 AI 配置及凭据" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding TestButtonLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" Margin="0,0,8,0" AutomationProperties.Name="测试 AI 连接" /><Button Content="保存配置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAiConfigCommand}" AutomationProperties.Name="保存 AI 配置" /></StackPanel>
                                            </DockPanel>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="验证草稿生成（使用额度）" Style="{StaticResource SecondaryButton}" Click="VerifyGeneration_Click" IsEnabled="{Binding CanVerifyGeneration}" Margin="0,0,6,6" />
                                                <Button Content="取消测试" Style="{StaticResource SecondaryButton}" Click="CancelAiVerification_Click" IsEnabled="{Binding IsTestingAi}" Margin="0,0,0,6" />
                                            </WrapPanel>
                                            <Expander Header="AI 配置迁移" Margin="0,6">
                                                <StackPanel Margin="0,8,0,0">
                                                    <TextBlock Text="完整配置包包含全部已保存配置、当前选择、自定义 Provider 预设和 API Key。文件使用迁移口令加密；导入后 Key 写入当前 Windows 账户的凭据库，并立即启用原当前配置。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                                    <WrapPanel Margin="0,9,0,0">
                                                        <Button Content="导出完整配置" Style="{StaticResource PrimaryButton}" Click="ExportCompleteAiConfigurations_Click" Margin="0,0,6,6" AutomationProperties.Name="加密导出包含 API Key 的完整 AI 配置" />
                                                        <Button Content="导入完整配置" Style="{StaticResource SecondaryButton}" Click="ImportCompleteAiConfigurations_Click" Margin="0,0,0,6" AutomationProperties.Name="导入并启用包含 API Key 的完整 AI 配置" />
                                                    </WrapPanel>
                                                    <TextBlock Text="兼容迁移（不含 Key）" Style="{StaticResource SectionLabel}" Margin="0,8,0,7" />
                                                    <WrapPanel>
                                                        <Button Content="导出无 Key 配置" Style="{StaticResource SecondaryButton}" Click="ExportAiConfigurations_Click" Margin="0,0,6,6" />
                                                        <Button Content="导入无 Key 配置" Style="{StaticResource SecondaryButton}" Click="ImportAiConfigurations_Click" Margin="0,0,6,6" />
                                                        <Button Content="导入 Provider 预设" Style="{StaticResource SecondaryButton}" Click="ImportProviderPresets_Click" Margin="0,0,0,6" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Expander>
                                            <TextBlock Text="{Binding AiStatus}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding AiStatusDetail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                    </Expander>
                                </Border>
                                <Button Content="打开用户手册" Style="{StaticResource SecondaryButton}" Command="{Binding OpenHelpCommand}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding SoftwareVersion, StringFormat='Windows AI Desktop Pet {0} · RGS_Dev CC0-1.0'}" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,12,0,4" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
